<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DgnKit\DgnKit.csproj" />
    <ProjectReference Include="..\DgnKit.Logic\DgnKit.Logic.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>DgnKit.Logic.Dgn</RootNamespace>
    <AssemblyName>DgnKit.Logic.Dgn</AssemblyName>
    <Description>DGN adapter for the DgnKit engineering logic layer: turns DGN elements (display-list geometry in metres, levels, cells, EC/tag metadata, sheet title blocks) into logic features. Zero third-party dependencies.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
